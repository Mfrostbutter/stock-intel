# Intraday recorder config. In the Compose deploy these live in the .env at the repo root.
# Secrets the recorder needs: ALPACA_API_KEY_ID, ALPACA_API_SECRET_KEY,
# STOCKS_INTRADAY_SVC_PASSWORD. They come from the environment, never from this file.

# Feed: iex = free tier. sip is the consolidated tape and needs a paid Alpaca plan.
SI_INTRADAY_FEED=iex

# Recorder universe (starter default; WF-01 movers discovery replaces it at session prep).
SI_INTRADAY_SYMBOLS=SPY,QQQ

# Poll cadence and lease TTL (seconds).
SI_INTRADAY_POLL_SECONDS=60
SI_INTRADAY_LEASE_SECONDS=120
