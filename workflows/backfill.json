    {
      "id": "b1a1b2c3-0007-4a00-8000-000000000007",
      "name": "Finish run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1856,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE intel.runs SET finished_at = now(), status = 'ok', summary = $2::jsonb WHERE run_id = $1::uuid RETURNING run_id::text, status;",
        "options": {
          "queryReplacement": "={{ [$('Build context (2y)').first().json.run_id, JSON.stringify({ prices: $('Collect-Prices').first().json, indicators: $json })] }}"
        }
      },
