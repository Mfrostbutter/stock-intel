  "nodes": [
    {
      "id": "b1a1b2c3-0001-4a00-8000-000000000001",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "b1a1b2c3-0002-4a00-8000-000000000002",
      "name": "Start run + watchlist",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        336,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH r AS (INSERT INTO intel.runs (run_id, kind, as_of) VALUES (gen_random_uuid(), 'backfill', CURRENT_DATE) RETURNING run_id)\nSELECT r.run_id::text AS run_id,\n       (SELECT array_agg(ticker ORDER BY ticker) FROM intel.watchlist WHERE active) AS tickers,\n       (SELECT array_agg(ticker ORDER BY ticker) FROM intel.watchlist WHERE active AND 'benchmark' = ANY(tags)) AS benchmarks\nFROM r;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "siCredPostgres01",
          "name": "Stock Intel Postgres (stocks_n8n)"
        }
      }
    },
    {
      "id": "b1a1b2c3-0003-4a00-8000-000000000003",
      "name": "Build context (2y)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json;\n// A webhook call may scope the backfill to specific tickers; a manual run does the whole list.\nlet want = null;\ntry { want = ($('Backfill webhook').first().json.body || {}).tickers || null; } catch (e) { want = null; }\nconst tickers = (Array.isArray(want) && want.length)\n  ? want.map((t) => String(t).trim().toUpperCase()).filter(Boolean)\n  : j.tickers;\nconst d = new Date(); d.setDate(d.getDate() - 1);\nwhile (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() - 1);\nconst iso = (x) => x.toISOString().slice(0, 10);\nconst s = new Date(d); s.setFullYear(s.getFullYear() - 2);\nreturn [{ json: { run_id: j.run_id, as_of: iso(d), tickers, benchmarks: j.benchmarks || [], start: iso(s), end: iso(d), days_back: 600 } }];"
      }
    },
    {
      "id": "b1a1b2c3-0004-4a00-8000-000000000004",
      "name": "Collect-Prices",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        928,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "siPrices00000001",
          "__workflowName": "stock-intel: Collect-Prices"
        },
        "mode": "once",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "b1a1b2c3-0005-4a00-8000-000000000005",
      "name": "Ctx",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        0
      ],
      "parameters": {
        "jsCode": "return $('Build context (2y)').all();"
      }
    },
    {
      "id": "b1a1b2c3-0006-4a00-8000-000000000006",
