# stock-intel app config. Copy to .env and fill in. .env is gitignored.
# In the Compose deploy these values come from the .env at the repo root.

# --- Network ---
# Host IP the app port binds to. 127.0.0.1 keeps it off the network; put a
# reverse proxy with auth in front before exposing it any wider.
HOST_BIND_IP=127.0.0.1
PORT=8095

# --- Auth ---
# Bearer token required on every /api route.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
STOCK_INTEL_APP_TOKEN=

# --- Postgres (stocks DB) ---
STOCKS_PG_HOST=postgres
STOCKS_PG_PORT=5432
STOCKS_PG_DB=stocks
STOCKS_PG_USER=stocks_app
STOCKS_APP_PG_PASSWORD=
# Read-only role the analyst's database tools query as.
# Empty falls back to stocks_app inside a READ ONLY transaction with a 5s statement timeout.
STOCKS_ANALYST_PG_USER=stocks_analyst
STOCKS_ANALYST_PG_PASSWORD=

# --- n8n ---
N8N_BASE_URL=http://n8n:5678
N8N_RUN_WEBHOOK_PATH=stock-intel/run
N8N_BACKFILL_WEBHOOK_PATH=stock-intel/backfill
# Shared header secret both directions.
STOCK_INTEL_N8N_WEBHOOK_SECRET=

# --- Finnhub (ticker validation on add) ---
FINNHUB_API_KEY=

# --- Alpaca (live quotes, optional; without these the UI stays on stored closes) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Free tier is the IEX tape. "sip" is the consolidated feed and needs a paid plan.
STOCK_INTEL_QUOTE_FEED=iex
# Shared server-side cache for /api/quotes, so extra browser tabs cost nothing.
STOCK_INTEL_QUOTE_CACHE_SECONDS=20

# --- Analyst LLM (anthropic | openai | ollama | openrouter) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stock-intel-analyst

TZ=America/New_York
